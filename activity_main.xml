<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:padding="20dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="Screen Translator 0.6" android:textSize="24sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button android:id="@+id/overlayButton" android:text="Разрешить поверх приложений"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/apiEdit" android:hint="URL LibreTranslate (например https://libretranslate.com)"
            android:inputType="textUri" android:singleLine="true"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/saveApiButton" android:text="Сохранить адрес перевода"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/captureButton" android:text="Запустить переводчик"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="После запуска: ВЫБРАТЬ → выдели текст → ПЕРЕВЕСТИ."
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="16dp"/>
    </LinearLayout>
</ScrollView>
